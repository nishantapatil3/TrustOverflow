FRONTEND_URL=http://localhost:5173
POSTGRES_DB=threadstack
POSTGRES_USER=threadstack
POSTGRES_PASSWORD=replace-me-local
DATABASE_URL=postgresql://threadstack:replace-me-local@db:5432/threadstack
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_RETRIES=5
DATABASE_RETRY_BASE_DELAY=0.25
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=/var/lib/threadstack/evidence
EVIDENCE_MAX_BYTES=10485760
