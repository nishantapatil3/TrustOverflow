FRONTEND_URL=http://localhost:5173
POSTGRES_DB=trustoverflow
POSTGRES_USER=trustoverflow
POSTGRES_PASSWORD=replace-me-local
DATABASE_URL=postgresql://trustoverflow:replace-me-local@db:5432/trustoverflow
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_RETRIES=5
DATABASE_RETRY_BASE_DELAY=0.25
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=/var/lib/trustoverflow/evidence
EVIDENCE_MAX_BYTES=10485760
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
THREAD_QUOTA_PER_DAY=100
POST_QUOTA_PER_DAY=500
EVIDENCE_QUOTA_PER_DAY=100
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@trustoverflow.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
PASSWORD_RESET_TTL_SECONDS=1800
